[Unit]
Description=CEM intelligent customer service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dsh
Group=dsh
WorkingDirectory=/srv/cem/app
EnvironmentFile=/etc/cem/cem.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=DSH_HOME=/var/lib/dsh
Environment=DSH_CWD=/var/lib/dsh/cem-runtime
Environment=DSH_MACAU_KNOWLEDGE_DIR=/var/lib/dsh/cem-runtime/knowledge/macau-customer-service
Environment=DSH_MACAU_KNOWLEDGE_MANIFEST=/var/lib/dsh/cem-runtime/knowledge/macau-customer-service/source-manifest.json
Environment=DSH_MACAU_KNOWLEDGE_INDEX=/var/lib/dsh/cem-runtime/index/macau-customer-service.index.json
ExecStart=/usr/local/bin/node apps/cli/lib/bin.js web --patch deploy/production.cordis.patch.yml --port 3080 --trusted-host 123.57.77.176
Restart=always
RestartSec=5
TimeoutStopSec=20
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/dsh

[Install]
WantedBy=multi-user.target
